@model HW_54.Models.ToDoTask

@{
    ViewData["Title"] = "Task Details";
}

<h1>Task Details</h1>

<div class="card">
    <div class="card-body">
        <h4>@Model.Title</h4>

        <p>
            <strong>Description:</strong> @Model.Description
        </p>

        <p>
            <strong>Executor:</strong> @Model.ResponsableName
        </p>

        <p>
            <strong>Priority:</strong> @Model.Priority
        </p>

        <p>
            <strong>Status:</strong> @Model.State
        </p>

        <p>
            <strong>Created on:</strong> @Model.CreatedOn.ToString("dd.MM.yyyy HH:mm")
        </p>

        @if (Model.State == HW_54.Models.TaskState.Closed && Model.ClosedOn != null)
        {
            <p>
                <strong>Closed on:</strong> @Model.ClosedOn.Value.ToString("dd.MM.yyyy HH:mm")
            </p>
        }
    </div>
</div>

<br />

<a asp-action="Index" asp-controller="Todo" class="btn btn-secondary">Back to tasks</a>